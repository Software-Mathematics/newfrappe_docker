# Host nginx reverse proxy for a SMERP deployment — rendered by
# deploy/build-deploy.sh (__DOMAIN__ / __BIND_PORT__ are substituted).
#
# Certbot (`certbot --nginx`) rewrites/adds the :443 server block and the
# HTTP->HTTPS redirect on first run, so this template only needs the :80 vhost
# proxying to the loopback-bound frontend container. build-deploy.sh therefore
# renders this ONCE (when the vhost does not exist yet) and never overwrites an
# existing vhost, so certbot's edits survive redeploys.
server {
    listen 80;
    listen [::]:80;
    server_name __DOMAIN__;

    # ERPNext file uploads / imports
    client_max_body_size 50m;

    location / {
        proxy_pass http://127.0.0.1:__BIND_PORT__;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # websocket (socket.io realtime) upgrade
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";

        proxy_read_timeout 120s;
        proxy_send_timeout 120s;
    }
}
